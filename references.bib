@incollection{cuppens-boulahia_unified_2012,
	address = {Berlin, Heidelberg},
	title = {A {Unified} {Attribute}-{Based} {Access} {Control} {Model} {Covering} {DAC}, {MAC} and {RBAC}},
	volume = {7371},
	isbn = {978-3-642-31539-8 978-3-642-31540-4},
	url = {http://link.springer.com/10.1007/978-3-642-31540-4_4},
	doi = {10.1007/978-3-642-31540-4_4},
	abstract = {Recently, there has been considerable interest in attribute based access control (ABAC) to overcome the limitations of the dominant access control models (i.e, discretionary-DAC, mandatory-MAC and role based-RBAC) while unifying their advantages. Although some proposals for ABAC have been published, and even implemented and standardized, there is no consensus on precisely what is meant by ABAC or the required features of ABAC. There is no widely accepted ABAC model as there are for DAC, MAC and RBAC. This paper takes a step towards this end by constructing an ABAC model that has “just suﬃcient” features to be “easily and naturally” conﬁgured to do DAC, MAC and RBAC. For this purpose we understand DAC to mean owner-controlled access control lists, MAC to mean lattice-based access control with tranquility and RBAC to mean ﬂat and hierarchical RBAC. Our central contribution is to take a ﬁrst cut at establishing formal connections between the three successful classical models and desired ABAC models.},
	language = {en},
	urldate = {2026-03-09},
	booktitle = {Data and {Applications} {Security} and {Privacy} {XXVI}},
	publisher = {Springer Berlin Heidelberg},
	author = {Jin, Xin and Krishnan, Ram and Sandhu, Ravi},
	editor = {Cuppens-Boulahia, Nora and Cuppens, Frédéric and Garcia-Alfaro, Joaquin},
	year = {2012},
	note = {Series Title: Lecture Notes in Computer Science},
	pages = {41--55},
}

